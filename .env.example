# ==========================================
# TraceFace SYSTEM ENVIRONMENT CONFIGURATION
# Copy to .env and fill in real values. Never commit .env.
# Canonical spec: docs/COMMON_REFERENCE.md §2
# ==========================================

# ============================================================
# MEMBER 1: AI / CV Configuration
# ============================================================

# Minimum confidence threshold for RetinaFace detection (0.0-1.0)
# Faces below this score are rejected during detection
FACE_DETECTION_CONFIDENCE=0.85

# Biometric similarity threshold for authentic match (0.0-1.0)
# Default: 0.68 (strict, high-confidence matches only)
# Recommended range: 0.65-0.75 for production use
FACE_SIMILARITY_THRESHOLD=0.68

# ArcFace embedding model backbone
# Options: buffalo_l (recommended), buffalo_mf, buffalo_f
# buffalo_l provides highest accuracy at cost of ~150MB download
EMBEDDING_MODEL_BACKBONE=buffalo_l

# Inference device: 'cuda' (GPU) or 'cpu'
# CUDA provides 3-5x speedup if available
DEVICE=cpu

# ============================================================
# MEMBER 2: OSINT Multi-Source Configuration
# ============================================================

# SerpApi Google Lens reverse image search key
# Get key at: https://serpapi.com/
# Required for: Google Lens visual search
SERPAPI_KEY=your_serpapi_key_here

# Bing Visual Search API key (optional secondary source)
# Get key at: https://azure.microsoft.com/en-us/services/cognitive-services/bing-visual-search/
# Enables multi-source aggregation when both SERPAPI_KEY and BING_VISUAL_SEARCH_KEY are configured
BING_VISUAL_SEARCH_KEY=your_bing_visual_key_optional

# Playwright headless browser mode
# true: runs silently (production), false: shows browser window (debugging)
PLAYWRIGHT_HEADLESS=true

# Maximum candidates to aggregate from all OSINT sources
# Recommended: 10-20 for optimal performance
SEARCH_MAX_CANDIDATES=10

# ============================================================
# MEMBER 3: Web3 Blockchain Configuration
# ============================================================

# Ethereum JSON-RPC endpoint URL
# Testnets:
#   - Polygon Amoy: https://rpc-amoy.polygon.technology/
#   - Arbitrum Sepolia: https://sepolia-rollup.arbitrum.io/rpc
#   - Local Anvil: http://127.0.0.1:8545
# Production: Use Alchemy, Infura, or QuickNode
RPC_URL=https://rpc-amoy.polygon.technology/

# Chain ID for transaction signing
# Polygon Amoy: 80002
# Arbitrum Sepolia: 421614
# Local Anvil: 31337
CHAIN_ID=80002

# Deployer private key (0x-prefixed hex string)
# NEVER commit real keys to version control
# For testing: Use Anvil dev keys (printed on startup) or metamask test accounts
# Production: Load from secure secret manager (AWS Secrets Manager, HashiCorp Vault)
PRIVATE_KEY=

# FaceProvenanceRegistry contract address (0x-prefixed)
# Deploy with: npx hardhat run contracts/scripts/deploy.js --network amoy
# Update after deployment to match actual address
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ============================================================
# IPFS DECENTRALIZED STORAGE
# ============================================================

# Pinata API credentials for IPFS pinning
# Get keys at: https://www.pinata.cloud/
# Required for: Persistent IPFS storage of forensic artifacts
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here

# IPFS gateway URL for content retrieval
# Pinata provides fastest access for pinned content
# Alternatives: https://ipfs.io/ipfs/, https://cloudflare-ipfs.com/ipfs/
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ============================================================
# GLOBAL APPLICATION SETTINGS
# ============================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# INFO: Production (recommended), DEBUG: Development
LOG_LEVEL=INFO

# Rich terminal UI rendering (true/false)
# true: Colored tables, progress bars (recommended)
# false: Plain text output (CI/CD environments)
ENABLE_RICH_TERMINAL=true

# ============================================================
# ADVANCED CONFIGURATION (Optional)
# ============================================================

# Maximum upload file size for API (bytes)
# Default: 15MB (15728640 bytes)
# MAX_UPLOAD_BYTES=15728640

# Media download timeout (seconds)
# DEFAULT: 15 seconds
# DOWNLOAD_TIMEOUT_SECONDS=15

# Maximum concurrent media downloads
# DEFAULT: 8 workers
# DOWNLOAD_CONCURRENCY=8

# Perceptual hash Hamming distance threshold for origin DAG
# Lower values = stricter image matching
# DEFAULT: 12 (recommended range: 8-15)
# MAX_HAMMING_DISTANCE=12
